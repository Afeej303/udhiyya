# Backend API endpoint (NestJS)
VITE_API_BASE_URL=http://localhost:3000

# Use in-memory mock client when backend is not running or during initial development
VITE_USE_MOCK_API=true

# Supabase Auth configuration (obtain from Supabase dashboard or local Supabase CLI)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# M3 Enhancement Feature Flags (off by default)
VITE_FEATURE_EF_01=off
VITE_FEATURE_EF_02=off
VITE_FEATURE_EF_03=off
VITE_FEATURE_EF_04=off
VITE_FEATURE_EF_05=off
